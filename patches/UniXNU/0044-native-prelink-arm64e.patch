diff --git a/kits/NativePrelink/native_prelink.py b/kits/NativePrelink/native_prelink.py
index 3ff3095..7167989 100755
--- a/kits/NativePrelink/native_prelink.py
+++ b/kits/NativePrelink/native_prelink.py
@@ -15,8 +15,12 @@ def macho(data, at=0):
     if at < 0 or at + 32 > len(data):
         raise ValueError('Mach-O header outside image')
     magic, cpu, subtype, kind, count, size = struct.unpack_from('<6I', data, at)
-    if (magic, cpu, subtype) != (0xfeedfacf, 0x100000c, 0):
-        raise ValueError('Only ordinary little-endian ARM64 is supported')
+    # Apple binaries from the pinned iPadOS baseline are arm64 (subtype 0); objects this tree
+    # compiles for an arm64e kernel are subtype 2. Both are little-endian ARM64 images and every
+    # layout walk below is subtype-agnostic, so accept both and expose which one was read.
+    architecture = {0: 'arm64', 2: 'arm64e'}.get(subtype & 0xff)
+    if magic != 0xfeedfacf or cpu != 0x100000c or architecture is None:
+        raise ValueError('Only little-endian ARM64/ARM64E is supported')
     end = at + 32 + size
     if end > len(data):
         raise ValueError('Load commands outside image')
