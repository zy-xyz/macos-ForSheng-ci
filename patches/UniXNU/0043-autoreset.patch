+++ b/drivers/NativeUfs/NativeUfs.cpp
@@ -1006,6 +1006,12 @@ static uint32_t be32w (const uint8_t *at)
 // is irrelevant here. Off unless sheng-log=1 (native_ufs_log_open() checks it).
 #include "../../../platform/sheng/macos26/storage/log_pump.h"
 
+// t107: unattended-run reset (UniXNU-sheng/package/BootReset.c, linked into this bundle).
+// Declared after the log-pump include so this patch always applies on top of 0042-log-pump.patch;
+// apply_patches.py walks the directory in name order, so 0042 precedes 0043.
+extern "C" int boot_reset_mark_bootloader (char *text, unsigned cap);
+extern "C" int boot_reset_watchdog (uint32_t deadline, char *text, unsigned cap);
+
 // ---- Persistent Data store window (sheng-data-persist) ----------------------------------------------------------
 // The only part of this driver that ever writes. The consumer (NativeRamBlock's overlay) asks for a window of the given
 // size at the END of the userdata partition. Mode 1 (boot argument sheng-data-persist=1) only reads: it proves the window and
@@ -2000,6 +2006,20 @@ bool NativeUfs::startRoot (IOService *provider)
     return false;
   }
   // Prepare all windows or publish none. Diagnostics never decide policy.
+  // t107: unattended-run reset. mark_bootloader() first, so every later restart (watchdog
+  // bite, panic, long press) comes up in fastboot; then arm the Gunyah watchdog, which makes
+  // the hypervisor restart the tablet even when this kernel is wedged. Without the boot
+  // argument both calls are skipped and a normal boot is unaffected.
+  {
+    uint32_t autoreset = 0;
+    if (PE_parse_boot_argn ("sheng-autoreset", &autoreset, sizeof autoreset) && autoreset) {
+      char resetText[160];
+      boot_reset_mark_bootloader (resetText, sizeof resetText);
+      sheng_log_stage (resetText);
+      boot_reset_watchdog (autoreset, resetText, sizeof resetText);
+      sheng_log_stage (resetText);
+    }
+  }
