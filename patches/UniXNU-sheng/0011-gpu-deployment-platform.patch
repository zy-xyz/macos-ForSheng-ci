diff --git a/scripts/build-arm-driver.py b/scripts/build-arm-driver.py
index e5554de..70714a8 100755
--- a/scripts/build-arm-driver.py
+++ b/scripts/build-arm-driver.py
@@ -104,9 +104,17 @@ for _ in range(count):
     if cmd == 0x32:
         deployment = struct.unpack_from('<II', data, offset + 8)
     offset += length
-if deployment != (2, 0x110000):
-    raise SystemExit(f'Unexpected platform deployment {deployment}')
+# The deployment comes from the XNU compilation record this builder reuses, so it must
+# match whatever the kernel itself was compiled for. macOS 26 kernels carry
+# LC_BUILD_VERSION platform=1 (macOS) minos=26.5; the upstream iPadOS 17 baseline carries
+# platform=2 minos=17.0. Accept either and record which one was seen: ld64 rejects a link
+# whose objects disagree on platform, so this is a link-time constraint, not a preference.
+ALLOWED_DEPLOYMENTS = {(1, 0x1A0500): 'macOS 26.5', (2, 0x110000): 'iOS 17.0'}
+if deployment not in ALLOWED_DEPLOYMENTS:
+    raise SystemExit(f'Unexpected platform deployment {deployment}; expected one of '
+                     + ', '.join(f'{k}={v}' for k, v in ALLOWED_DEPLOYMENTS.items()))
+deployment_label = ALLOWED_DEPLOYMENTS[deployment]
 archive = out / ('lib' + component + '.a')
 archive.unlink(missing_ok=True)
 subprocess.run(['xcrun', 'ar', 'rcs', archive, destination], check=True)
-print(f'{component}: -Werror build and actual ARM64/iOS 17 object audit passed')
+print(f'{component}: -Werror build and actual ARM64/{deployment_label} object audit passed')
